<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP en clair autorisé UNIQUEMENT vers l'API UniStream du Pi (réseau local). Tout le reste reste en HTTPS
     obligatoire (règle par défaut d'Android 9+). Si l'adresse du Pi change, la changer ici aussi. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.80</domain>
    </domain-config>
</network-security-config>
